# Bright Box Homes - environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (database, auth, storage) ---
# Public project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key, safe to expose to the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Stripe (deposit checkout, Phase 1B) ---
# Secret key - SERVER ONLY.
STRIPE_SECRET_KEY=
# Webhook signing secret for verifying Stripe event payloads - SERVER ONLY.
STRIPE_WEBHOOK_SECRET=
# Publishable key, safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Site ---
# Canonical site origin, e.g. https://brightboxhomes.com
NEXT_PUBLIC_SITE_URL=

# --- Analytics ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID.
NEXT_PUBLIC_CLARITY_ID=

# --- Rewardful (affiliate program, Phase 1B) ---
REWARDFUL_API_KEY=

# --- Cal.com (consultation booking) ---
CAL_COM_API_KEY=
